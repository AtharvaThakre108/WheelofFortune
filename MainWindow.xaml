<Window x:Class="WheelPicker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wheel Picker"
        Height="700"
        Width="700">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">

            <Polygon Points="340,20 360,20 350,50"
                    Fill="Red"
                    Panel.ZIndex="100"/>

            <Canvas x:Name="WheelCanvas"
                    Width="500"
                    Height="500"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <Canvas.RenderTransform>
                    <RotateTransform x:Name="WheelRotation"
                                    CenterX="250"
                                    CenterY="250"/>
                </Canvas.RenderTransform>

            </Canvas>

        </Grid>

        <StackPanel Grid.Row="1"
            Orientation="Horizontal"
            HorizontalAlignment="Center">

            <Button Content="SPIN"
                    Width="150"
                    Height="50"
                    Margin="5"
                    Click="SpinButton_Click"/>

            <Button Content="LOAD MUSIC"
                    Width="150"
                    Height="50"
                    Margin="5"
                    Click="LoadMusic_Click"/>

        </StackPanel>

        <TextBlock Grid.Row="2"
                x:Name="ResultText"
                FontSize="30"
                FontWeight="Bold"
                Margin="20"
                HorizontalAlignment="Center"/>

    </Grid>
</Window>