<Window x:Class="WheelPicker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wheel Picker"
        Icon="Assets/wheelpicker.ico"
        Height="800"
        Width="700">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">

            <Canvas Width="500"
                    Height="500"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Panel.ZIndex="100"
                    IsHitTestVisible="False">

                <Polygon Points="235,5 265,5 250,30"
                        Fill="Red"/>

            </Canvas>

            <Canvas x:Name="WheelCanvas"
                    Width="500"
                    Height="500"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <Canvas.RenderTransform>
                    <RotateTransform x:Name="WheelRotation"
                                    CenterX="250"
                                    CenterY="250"/>
                </Canvas.RenderTransform>

            </Canvas>

        </Grid>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="10">

            <TextBlock Text="Library:"
                    VerticalAlignment="Center"
                    Margin="0,0,10,0"
                    FontSize="18"/>

            <ComboBox x:Name="LibraryComboBox"
                    Width="250"
                    Height="35"
                    SelectionChanged="LibraryComboBox_SelectionChanged"/>

        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="10">

            <Button Content="BACK"
                    Width="120"
                    Height="40"
                    Margin="10"
                    Click="BackButton_Click"/>

            <Button Content="SPIN"
                    Width="220"
                    Height="60"
                    Margin="10"
                    Click="SpinButton_Click"/>

        </StackPanel>

        <TextBlock Grid.Row="3"
                x:Name="ResultText"
                FontSize="30"
                FontWeight="Bold"
                Margin="10"
                HorizontalAlignment="Center"/>

    </Grid>
</Window>